{
  "name": "generator-nr-repository-composer",
  "version": "1.0.0",
  "description": "Generate NR",
  "files": [
    "generators"
  ],
  "main": "generators/index.js",
  "keywords": [
    "yeoman-generator"
  ],
  "engines": {
    "npm": ">= 4.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "docs:serve": "npx --yes docsify-cli serve docs"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "yaml": "^2.9.0",
    "yeoman-generator": "^8.2.2",
    "yosay": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "yeoman-assert": "^3.1.1",
    "yeoman-test": "^11.6.0"
  },
  "type": "module",
  "license": "Apache-2.0",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
